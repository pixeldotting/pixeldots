# Home-manager module. `inputs` comes from flake.nix (see homeManagerModules.default).
inputs:
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.programs.material;
  system = pkgs.stdenv.hostPlatform.system;
  scripts = import ./scripts.nix { inherit pkgs; };

  # Either copy into the store (reproducible) or symlink to a checkout (edit-and-reload).
  link =
    sub:
    if cfg.repoPath == null then
      {
        source = ../config + "/${sub}";
        recursive = true;
      }
    else
      {
        source = config.lib.file.mkOutOfStoreSymlink "${cfg.repoPath}/config/${sub}";
      };
in
{
  options.programs.material = {
    enable = lib.mkEnableOption "the Material You Hyprland + Quickshell desktop";

    quickshellPackage = lib.mkOption {
      type = lib.types.package;
      default = inputs.quickshell.packages.${system}.default;
      defaultText = lib.literalExpression "inputs.quickshell.packages.\${system}.default";
      description = "Quickshell build used to run the shell.";
    };

    repoPath = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      example = "/home/you/pixeldots";
      description = ''
        Absolute path of a checkout of this repository. When set, ~/.config/hypr and
        ~/.config/quickshell/material are symlinked to it (outside the store) so edits apply
        without a rebuild. When null, everything is copied into the store.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    home.packages =
      [
        cfg.quickshellPackage
        scripts.material-theme
        scripts.material-screenshot
      ]
      ++ (with pkgs; [
        # theming
        matugen
        adw-gtk3
        papirus-icon-theme
        bibata-cursors
        kdePackages.qt6ct

        # what the shell and keybinds call
        jq
        curl
        brightnessctl
        playerctl
        libnotify
        wl-clipboard
        cliphist
        grim
        slurp
        hyprpicker
        networkmanager # nmcli
        power-profiles-daemon # powerprofilesctl
        hyprpolkitagent

        # apps referenced from the Hyprland config
        kitty
        thunar
        firefox

        # fonts
        rubik
        material-symbols
        nerd-fonts.caskaydia-cove

        # shell niceties
        starship
        eza
        bat
        fd
        ripgrep
      ]);

    fonts.fontconfig.enable = true;

    # ── Hyprland (Lua), Quickshell, matugen ────────────────────────
    xdg.configFile = {
      "hypr" = link "hypr";
      "quickshell/material" = link "quickshell/material";

      "matugen/config.toml".source = ../config/matugen/config.toml;
      "matugen/templates" = {
        source = ../config/matugen/templates;
        recursive = true;
      };

      # Qt 6 apps read their palette from the file matugen generates.
      "qt6ct/qt6ct.conf".text = ''
        [Appearance]
        color_scheme_path=${config.xdg.configHome}/qt6ct/colors/material.conf
        custom_palette=true
        icon_theme=Papirus-Dark
        standard_dialogs=default
        style=Fusion

        [Fonts]
        fixed="CaskaydiaCove Nerd Font,11,-1,5,50,0,0,0,0,0"
        general="Rubik,11,-1,5,50,0,0,0,0,0"
      '';
    };

    # A starter wallpaper so the first colour scheme can be generated out of the box.
    home.file."Pictures/Wallpapers/aurora.png".source = ../wallpapers/aurora.png;

    # ── GTK / cursor ───────────────────────────────────────────────
    gtk = {
      enable = true;
      theme = {
        name = "adw-gtk3-dark";
        package = pkgs.adw-gtk3;
      };
      iconTheme = {
        name = "Papirus-Dark";
        package = pkgs.papirus-icon-theme;
      };
      # matugen writes colors.css next to these files
      gtk3.extraCss = ''@import url("colors.css");'';
      gtk4.extraCss = ''@import url("colors.css");'';
      gtk4.theme = null;
    };

    home.pointerCursor = {
      package = pkgs.bibata-cursors;
      name = "Bibata-Modern-Classic";
      size = 24;
      gtk.enable = true;
      x11.enable = true;
    };

    # ── Terminal & shell ───────────────────────────────────────────
    programs.kitty = {
      enable = true;
      font = {
        name = "CaskaydiaCove Nerd Font";
        size = 12;
      };
      settings = {
        background_opacity = "0.92";
        window_padding_width = 10;
        confirm_os_window_close = 0;
        enable_audio_bell = false;
        cursor_trail = 3;
        tab_bar_style = "powerline";
        tab_powerline_style = "round";
        scrollback_lines = 10000;
        # `pkill -USR1 kitty` (run by matugen) reloads this file
        allow_remote_control = "no";
      };
      # generated by matugen; kitty silently ignores a missing include
      extraConfig = "include colors.conf";
    };

    programs.fish = {
      enable = true;
      interactiveShellInit = ''
        set fish_greeting
        # starship.toml is generated by matugen (Material You prompt colours)
        starship init fish | source
      '';
      shellAbbrs = {
        ls = "eza --icons";
        ll = "eza -l --icons --git";
        la = "eza -la --icons --git";
        cat = "bat";
        g = "git";
      };
    };

    # First activation: pick a wallpaper and generate every colour file.
    home.activation.materialTheme = lib.hm.dag.entryAfter [ "linkGeneration" ] ''
      run ${scripts.material-theme}/bin/material-theme init || true
    '';
  };
}
